# Copy to .env — every value except ANTHROPIC_API_KEY has a working default,
# so the app boots against the Docker Compose database with zero changes.

# Postgres (matches docker-compose.yml; host port 5436)
DATABASE_URL=postgresql://loopp:loopp@localhost:5436/loopp

# Anthropic API key — required only when the agent runs (console.anthropic.com)
ANTHROPIC_API_KEY=

# Anthropic model id — optional, defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# API server port
PORT=4011
