{
  "name": "loopp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "dev": "pnpm -r --parallel --stream dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @loopp/db push",
    "db:seed": "pnpm --filter @loopp/db seed",
    "setup": "pnpm --filter @loopp/db preflight && pnpm db:up && pnpm db:push && pnpm db:seed",
    "red-team": "pnpm --filter @loopp/agent red-team",
    "typecheck": "pnpm -r typecheck"
  }
}
